{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "tags": {
      "value": {
        "SecurityControl": "Ignore",
        "CostControl": "Ignore"
      }
    },
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "location": {
      "value": "${AZURE_LOCATION=eastus}"
    },
    "litellmMasterKey": {
      "value": "${LITELLM_MASTER_KEY}"
    },
    "modelCapacity": {
      "value": "${MODEL_CAPACITY=10}"
    },
    "gatewayAuthMode": {
      "value": "${GATEWAY_AUTH_MODE=api_key}"
    },
    "hostedAuthMode": {
      "value": "${HOSTED_AUTH_MODE=api_key}"
    },
    "promptAuthMode": {
      "value": "${PROMPT_AUTH_MODE=api_key}"
    },
    "litellmImage": {
      "value": "${LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.105.1}"
    },
    "entraTenantId": {
      "value": "${ENTRA_TENANT_ID=}"
    },
    "entraGatewayClientId": {
      "value": "${ENTRA_GATEWAY_CLIENT_ID=}"
    },
    "entraAgentClientId": {
      "value": "${ENTRA_AGENT_CLIENT_ID=}"
    },
    "entraAgentPrincipalId": {
      "value": "${ENTRA_AGENT_PRINCIPAL_ID=}"
    },
    "promptClientId": {
      "value": "${ENTRA_PROMPT_CLIENT_ID=}"
    },
    "entraAppPrincipals": {
      "value": "${ENTRA_APP_PRINCIPALS=[]}"
    },
    "entraDelegatedUsers": {
      "value": "${ENTRA_DELEGATED_USERS=[]}"
    },
    "entraDelegatedActors": {
      "value": "${ENTRA_DELEGATED_ACTORS=[]}"
    },
    "entraDelegatedOnly": {
      "value": "${ENTRA_DELEGATED_ONLY=false}"
    },
    "entraCapabilities": {
      "value": "${ENTRA_CAPABILITIES}"
    },
    "enableDemoBackends": {
      "value": "${ENABLE_DEMO_BACKENDS=false}"
    },
    "demoMcpExists": {
      "value": "${SERVICE_DEMO_MCP_RESOURCE_EXISTS=false}"
    },
    "demoA2aExists": {
      "value": "${SERVICE_DEMO_A2A_RESOURCE_EXISTS=false}"
    }
  }
}
