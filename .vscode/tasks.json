{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run hosted tutor HTTP server",
      "type": "shell",
      "command": "azd ai agent run ai-tutor-hosted-agent --no-client --start-command '.venv/bin/python -m debugpy --listen 127.0.0.1:5679 main.py'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^.*$",
            "file": 0,
            "location": 1,
            "message": 2
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Application startup complete|[Rr]unning on|Started server process"
        }
      }
    },
    {
      "label": "Open hosted tutor Inspector",
      "type": "shell",
      "command": "echo '${input:openAgentInspector}'",
      "dependsOn": "Run hosted tutor HTTP server",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "openAgentInspector",
      "type": "command",
      "command": "ai-mlstudio.openTestTool",
      "args": {
        "triggeredFrom": "tasks",
        "port": 8088
      }
    }
  ]
}
